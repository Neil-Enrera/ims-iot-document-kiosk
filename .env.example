# Application
APP_NAME=IMS Document Request Services
NODE_ENV=production
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ims_iot_document_kiosk
DB_USER=ims_user
DB_PASSWORD=your_secure_password_here

# Frontend & Kiosk URLs
FRONTEND_URL=http://13.250.176.247
KIOSK_URL=http://192.168.100.102:4201

# Authentication Security
JWT_SECRET=change_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Logging
LOG_LEVEL=info

# SMTP Email Configuration (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Barangay San Manuel IMS" <your_email@gmail.com>
