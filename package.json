{
  "name": "ims-iot-document-kiosk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve admin-panel",
    "start:admin": "ng serve admin-panel --open",
    "start:kiosk": "ng serve kiosk-app --port 4201 --open",
    "start:backend": "node backend/src/server.js",
    "start:all": "concurrently \"npm run start:backend\" \"npm run start:admin\" \"npm run start:kiosk\"",
    "start:dev": "concurrently \"npm run start:backend\" \"npm run start:admin\" \"npm run start:kiosk\"",
    "build": "ng build admin-panel",
    "build:admin": "ng build admin-panel",
    "build:kiosk": "ng build kiosk-app",
    "build:all": "ng build admin-panel && ng build kiosk-app",
    "watch": "ng build admin-panel --watch --configuration development",
    "test": "ng test admin-panel",
    "serve:ssr:admin-panel": "node dist/admin-panel/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "docx-preview": "^0.4.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.1.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
